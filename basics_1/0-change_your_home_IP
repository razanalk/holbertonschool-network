#!/usr/bin/env bash
# Configure localhost and facebook.com to resolve to specific IP addresses

sed '/[[:space:]]localhost\([[:space:]]\|$\)/d; /[[:space:]]facebook\.com\([[:space:]]\|$\)/d' /etc/hosts > /tmp/hosts_updated
cat /tmp/hosts_updated > /etc/hosts
printf '127.0.0.2 localhost\n8.8.8.8 facebook.com\n' >> /etc/hosts
rm -f /tmp/hosts_updated
